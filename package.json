{
  "name": "dsh-cursor-dev",
  "displayName": "Cursor 子智能体",
  "description": "把 Cursor CLI 当作子编码智能体来写业务代码：每次运行都在 DSH 里开一个真实的子会话（点开就是完整对话），可按任务选模型、会话在 DSH 重启后仍能续聊、返回逐步工具时间线与真实文件 diff，并自带额度/模型/会话面板。",
  "version": "0.6.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node --test --test-force-exit \"test/**/*.test.mjs\""
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cursor",
    "acp",
    "subagent",
    "coding-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dclef/dsh-cursor-dev.git"
  },
  "homepage": "https://github.com/Dclef/dsh-cursor-dev#readme",
  "bugs": {
    "url": "https://github.com/Dclef/dsh-cursor-dev/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    },
    "manifestVersion": 1,
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    }
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
